  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"hospital@lifelink.dev\", \"password\": \"password123\"}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Login - invalid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"hospital@lifelink.dev\", \"password\": \"wrong\"}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Get current user - unauthorized (no token)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me"
          }
        }
      ]
    },
