ENVIRONMENT=development
PROJECT_NAME=Life Link API
API_V1_PREFIX=/api/v1

# Local/test mode (recommended for development)
REPOSITORY_BACKEND=memory

# Shared SQL Server/Azure SQL mode (replace placeholders; never commit real credentials)
# REPOSITORY_BACKEND=sqlserver
# DATABASE_URL="mssql+pyodbc://USERNAME:PASSWORD@SERVER.database.windows.net/DATABASE?driver=ODBC+Driver+18+for+SQL+Server"

# Generate a strong secret and keep it outside source control in staging/production.
SECRET_KEY=change-me-generate-a-real-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FILE_STORAGE_ROOT=./storage
MAX_UPLOAD_MB=10

# Azure Blob Storage (optional; leave empty for local storage)
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME=medical-docs

CORS_ORIGINS=["*"]
