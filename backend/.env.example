ENVIRONMENT=development

# SQL Server/Azure SQL connection used when REPOSITORY_BACKEND=sqlserver.
DATABASE_URL="mssql+pyodbc://lifelinkadmin:MA_AH_se_to2026@lifelink-srv-de.database.windows.net/lifelink-db-dev?driver=ODBC+Driver+18+for+SQL+Server"
REPOSITORY_BACKEND=sqlserver
# Generate a strong secret and store it outside source control for staging/production.
SECRET_KEY=change-me-generate-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

REPOSITORY_BACKEND=memory
FILE_STORAGE_ROOT=./storage
MAX_UPLOAD_MB=10
# Azure Blob Storage (leave empty to use local container disk storage)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="medical-docs"
CORS_ORIGINS=["*"]
